# Copy to .env for local use (the server does not load .env itself: `set -a; source .env; set +a; npm start`).
# On Render these are set in the dashboard / render.yaml. Never commit real values.

# Port the server listens on. Render sets this itself.
PORT=3000

# Orchestra stem separation (Hugging Face Space from separator/). Leave empty to disable separation.
SEPARATOR_URL=
# Same secret as the Space's SEPARATOR_TOKEN (generate: openssl rand -hex 32)
SEPARATOR_TOKEN=

# Total uploaded audio kept on disk (MB); oldest files are evicted beyond this. Default 500.
MAX_UPLOAD_MB=500
# Seconds before an uploaded file is deleted (0 = keep until the room ends). Default 21600 (6 h).
UPLOAD_TTL=21600
# Optional: uploads per IP per 10 min (30) and room creations per IP per minute (120).
# UPLOAD_RATE=30
# ROOM_RATE=120

# Local HTTPS only (mkcert), see README. Not needed on Render (HTTPS is automatic).
SSL_KEY=
SSL_CERT=

# Folder of pre-separated demo songs (default server/demo).
DEMO_DIR=
